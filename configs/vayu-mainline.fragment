# Drivers a mainline kernel needs that the vendor 5.4 config never enabled.
#
# The LineageOS config reaches the hardware through techpack/KGSL/SDE/qcacld,
# so it leaves the upstream drivers off (DRM_MSM, ATH10K_SNOC, SCSI_UFS_QCOM,
# ...). Those vendor symbols do not exist in 6.18, so the filtered config alone
# would describe a kernel with no display, no storage and no Wi-Fi. This
# fragment turns the upstream equivalents on.
#
# Every symbol here is checked against the target tree's Kconfig by
# scripts/gen-config.py --fragment; a typo fails the generator, not the build.

# --- Android platform -------------------------------------------------------
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y

# --- clocks, regulators, pinctrl, interconnect ------------------------------
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_PINCTRL_SM8150=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_SM8150=y

# --- SoC plumbing -----------------------------------------------------------
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMEM_STATE=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y
CONFIG_QCOM_GENI_SE=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_CPR=y
CONFIG_ARM_SMMU=y

# --- remoteproc / modem -----------------------------------------------------
CONFIG_REMOTEPROC=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_IPA=y

# --- display and GPU --------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y

# --- storage ----------------------------------------------------------------
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y

# --- USB --------------------------------------------------------------------
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QUSB2=y

# --- serial: ttyMSM0 console and the Bluetooth UART -------------------------
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y

# --- WLAN / Bluetooth -------------------------------------------------------
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_BT_QCA=y
CONFIG_BT_HCIUART=y

# --- CPU frequency ----------------------------------------------------------
CONFIG_ARM_QCOM_CPUFREQ_HW=y
